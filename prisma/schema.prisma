generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String    @id @default(uuid(7))
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash")
  role         Role      @default(ATTENDEE)
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  events       Event[]
  orders       Order[]

  @@map("users")
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

model Event {
  id           String       @id @default(uuid(7))
  title        String       @db.VarChar(100)
  description  String?      @db.Text
  venueName    String       @map("venue_name") @db.VarChar(100)
  venueAddress String       @map("venue_address") @db.VarChar(100)
  venueCity    String       @map("venue_city") @db.VarChar(100)
  status       EventStatus  @default(DRAFT)
  startTime    DateTime     @map("start_time")
  organizer    User         @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  organizerId  String       @map("organizer_id")
  publishAt    DateTime?    @map("publish_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  ticketTiers  TicketTier[]

  @@map("events")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model TicketTier {
  id         String      @id @default(uuid(7))
  name       String      @db.VarChar(100)
  price      Decimal     @db.Decimal(10, 2)
  capacity   Int
  available  Int
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String      @map("event_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  orderItems OrderItem[]

  @@map("ticket_tiers")
}

model Order {
  id         String      @id @default(uuid(7))
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String      @map("user_id")
  totalPrice Decimal     @map("total_price") @db.Decimal(10, 2)
  status     OrderStatus @default(PENDING)
  reference  String?     @db.VarChar(30)
  paidAt     DateTime?   @map("paid_at")
  expiresAt  DateTime    @map("expires_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  orderItems OrderItem[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

model OrderItem {
  id           String     @id @default(uuid(7))
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String     @map("order_id")
  ticketTier   TicketTier @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)
  ticketTierId String     @map("ticket_tier_id")
  quantity     Int
  unitPrice    Decimal    @map("unit_price") @db.Decimal(10, 2)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  tickets      Ticket[]

  @@map("order_items")
}

model Ticket {
  id          String       @id @default(uuid(7))
  code        String       @unique @db.VarChar(10)
  status      TicketStatus @default(VALID)
  checkedInAt DateTime?    @map("checked_in_at")
  OrderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String       @map("order_item_id")
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}
